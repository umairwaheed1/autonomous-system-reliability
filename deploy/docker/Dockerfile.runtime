# ==========================================
# Stage 1: Build & Dependencies
# ==========================================
FROM python:3.10-slim AS builder

WORKDIR /app

# Install build essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies into a local prefix
COPY requirements.txt pyproject.toml ./
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ==========================================
# Stage 2: Production Runtime Image
# ==========================================
FROM python:3.10-slim AS runtime

WORKDIR /app

# Copy installed dependencies from builder
COPY --from=builder /install /usr/local

# Copy application source code
COPY src/ ./src/
COPY config/ ./config/

# Create a non-privileged system user for enterprise security
RUN useradd -u 10001 -m appuser && chown -R appuser:appuser /app
USER 10001

# Set production environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Expose control plane or microservice port
EXPOSE 8080

# Default execution command under supervisor watch
CMD ["python", "-m", "src.api.service"]